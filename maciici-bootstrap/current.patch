diff --git a/core/src/emulator/mod.rs b/core/src/emulator/mod.rs
index 206b4e8..d57c697 100644
--- a/core/src/emulator/mod.rs
+++ b/core/src/emulator/mod.rs
@@ -416,6 +416,34 @@ impl Emulator {
 
                 EmulatorConfig::MacII30(cpu)
             }
+            MacModel::MacIIci => {
+                assert!(override_fdd_type.is_none());
+
+                // The IIci has RBV-controlled onboard video and therefore does not
+                // require a NuBus declaration ROM.  The renderer is connected by
+                // the IIci bus implementation.
+                let nubus = [];
+
+                let extension_rom = extra_roms.iter().find_map(|p| match p {
+                    ExtraROMs::ExtensionROM(data) => Some(*data),
+                    _ => None,
+                });
+
+                let bus = MacIIBus::new(
+                    model,
+                    rom,
+                    &nubus,
+                    extension_rom,
+                    vec![renderer],
+                    monitor.unwrap_or_default(),
+                    mouse_mode,
+                    ram_size,
+                );
+                let cpu = Box::new(CpuM68030Fpu::new(bus));
+                assert_eq!(cpu.get_type(), model.cpu_type());
+
+                EmulatorConfig::MacII30(cpu)
+            }
             MacModel::SE30 => {
                 assert!(override_fdd_type.is_none());
 
